# Supabase project settings (Project Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. NEVER expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# TechKnox AI Chatbot API key (Server-only).
GEMINI_API_KEY=your_gemini_api_key

# Used for canonical URLs / SEO metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3001